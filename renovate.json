{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":automergeMinor"],
  "labels": ["renovate"],
  "packageRules": [
    {
      "groupName": "conform-to",
      "matchPackageNames": ["@conform-to/react", "@conform-to/zod"]
    },
    {
      "groupName": "heroui",
      "matchPackageNames": ["@heroui/react", "@heroui/styles"]
    },
    {
      "groupName": "react",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"]
    },
    {
      "groupName": "oxc",
      "matchPackageNames": ["oxlint", "oxfmt", "oxlint-tailwindcss"]
    },
    {
      "description": "Node.js の実行環境（.mise.toml・engines）に合わせて 24 系に留める",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "24.x"
    }
  ]
}
