{
  "name": "passtune",
  "version": "0.0.0",
  "private": true,
  "description": "友人間で好きな曲を 1 曲ずつ届け合う音楽共有 SNS",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "check": "oxlint --fix && oxfmt",
    "type": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "spell": "cspell . --gitignore",
    "supabase:start": "supabase start --runtime native -x realtime,functions,analytics,pooler",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:migration": "supabase migration new",
    "supabase:type": "supabase gen types typescript --local > lib/database.types.ts",
    "supabase:test": "supabase test db",
    "supabase:sync": "supabase db schema declarative sync --apply --name",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@conform-to/react": "1.21.2",
    "@conform-to/zod": "1.21.2",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@iconify/react": "6.0.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tailwindcss/postcss": "4.3.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "dayjs": "1.11.23",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "postcss": "8.5.30",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "use-debounce": "10.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cspell": "10.3.6",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tailwindcss": "1.13.0",
    "supabase": "2.120.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.13.0"
}
