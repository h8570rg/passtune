{
  "name": "passtune",
  "version": "0.0.0",
  "private": true,
  "description": "友人間で好きな曲を 1 曲ずつ届け合う音楽共有 SNS",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "check": "oxlint --fix && oxfmt",
    "type": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "spell": "cspell . --gitignore",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:migration": "supabase migration new",
    "supabase:diff": "supabase db diff --local --schema public",
    "supabase:type": "supabase gen types typescript --local > lib/database.types.ts"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "25.9.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cspell": "10.3.4",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tailwindcss": "1.13.0",
    "supabase": "2.117.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.6.0"
}
