# 手元の開発用。`cp .env.example .env.local` でコピーして使う。本番の値はここに書かない。
# このファイルは Next.js と Supabase CLI（pnpm supabase:start）の両方が読む。

# 手元の Supabase（pnpm supabase:start）の既定値
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# 任意: Google ログイン（Google Cloud の OAuth クライアント）。設定後は pnpm supabase:stop → pnpm supabase:start
# 空のままでも動く（Google ログインだけが失敗する）。手順は docs/technical/development.md
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# 任意: 「Spotify で開く」を曲ページへ直接飛ばす（Spotify for Developers のアプリ）。設定後は pnpm dev を再起動
# 空のままでも動く（Spotify の検索結果へ飛ぶ）
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
